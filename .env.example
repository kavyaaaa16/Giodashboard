# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it should hold your actual credentials.

# Full connection string to medlingodb. Example shape (fill in the real password):
# postgresql://gioadmin:YOUR_PASSWORD@azkc-gio-postgresql-dev.postgres.database.azure.com:5432/medlingodb?sslmode=require
DATABASE_URL=

# Port this local API listens on
PORT=4000

# Set this before deploying, to the real frontend's URL, to lock CORS down.
# Leave blank for local dev — CORS stays open, which is fine on localhost.
FRONTEND_URL=

# Minimum encounter count per breakdown bucket before it's shown.
# Matches the dashboard's suppression rule (Section 8 of the governance doc).
SUPPRESSION_MIN=20

# --- Artifact download (real files: SOAP notes, transcripts, translations) ---
# Connection string for the medlingodev storage account. Get this from
# whoever manages that resource — ideally a SAS/scoped credential, not the
# full account key, but the full key will technically work if that's all
# that's available right now.
AZURE_STORAGE_CONNECTION_STRING=

# IMPORTANT — read this before relying on it:
# This is a coarse, temporary gate, NOT real security. There is no real
# authentication in this prototype yet, so this is the only thing standing
# between "anyone who can reach this server" and "real clinical documents."
# Anyone with this token can download any encounter's artifacts. Treat it
# like a password: don't commit it, don't share it outside the team, and
# do not consider this sufficient once this moves anywhere beyond a
# laptop-to-laptop local test. Pick a long random value, e.g. via:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ELEVATED_ACCESS_TOKEN=
